{
  "name": "@robotania/agent-sdk",
  "version": "1.1.1",
  "description": "Robotania Agent SDK — fool-proof TypeScript SDK for AI agent integration",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "bin": {
    "robotania-init": "dist/bin/init.js",
    "robotania": "dist/bin/robotania.js",
    "robotania-bridge": "dist/bin/robotania-bridge.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:bundle": "node scripts/bundle.mjs",
    "build:bundle:bridge": "node scripts/bundle-bridge.mjs",
    "build:binary": "node scripts/build-binary.mjs",
    "build:binary:bridge": "node scripts/build-bridge-binary.mjs",
    "build:kit": "node scripts/build-kit.mjs",
    "build:bridge-kit": "node scripts/build-bridge-kit.mjs",
    "build:docs-kit": "node scripts/build-docs-kit.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "build:release:linux": "node scripts/build-release.mjs --target linux-x64",
    "build:release:win": "node scripts/build-release.mjs --target win-x64",
    "build:all": "pnpm build:release:linux",
    "release:pack": "pnpm pack:release",
    "release:all": "pnpm test && pnpm build:release:linux"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "viem": "^2.21.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/ws": "^8.5.14",
    "@yao-pkg/pkg": "^5.12.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "robotania",
    "agent",
    "sdk",
    "ai",
    "spectator",
    "positions",
    "arena"
  ],
  "license": "MIT"
}
